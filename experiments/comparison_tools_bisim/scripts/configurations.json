{
  "storm-sound": {
    "bin": "bin/storm",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --sound",
    "description": "Storm with sound computations."
  },
  "storm-old-sound": {
    "bin": "bin/storm-old",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --sound",
    "description": "Storm 1.6.2 with sound computations, like storm-sound."
  },
  "storm-old-exact": {
    "bin": "bin/storm-old",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --exact",
    "description": "Storm 1.6.2 with exact computations, like storm-exact."
  },
  "storm-hybrid-sound": {
    "bin": "bin/storm",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --engine hybrid --sound --sylvan:threads 4 --sylvan:maxmem 4096",
    "description": "Storm with hybrid engine and sound computations."
  },
  "storm-exact": {
    "bin": "bin/storm",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --exact",
    "description": "Storm with exact computations."
  },
  "storm-sound-bisim": {
    "bin": "bin/storm",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --sound --bisimulation",
    "description": "Storm with default settings and strong bisimulation preprocessing."
  },
  "storm-sound-ddbisim": {
    "bin": "bin/storm",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --sound --bisimulation --engine dd-to-sparse  --sylvan:threads 4 --sylvan:maxmem 8192",
    "description": "Storm with symbolic (strong) bisimulation"
  },
  "storm-exact-bisim": {
    "bin": "bin/storm",
    "cmd": "--jani %jani --janiproperty %property --constants %constants --exact --bisimulation",
    "description": "Storm with exact computations and strong bisimulation preprocessing."
  },
  "mcsta-ovi": {
    "bin": "bin/modest",
    "cmd": "mcsta %jani --props %property --experiment %constants --unsafe --store-mode Memory --alg OptimisticValueIteration --width 1e-6 --relative-width",
    "description": "mcsta with optimistic value iteration. Omit runtime checks. Have everything in memory (no disk)"
  },
  "prism-ii": {
    "bin": "bin/prism",
    "cmd": "-javamaxmem %memlimit %prism %prism-property --prop %property -const %constants -maxiters 1000000 -intervaliter -heuristic speed -ddextraactionvars 100 -cuddmaxmem 8g",
    "description": "Prism with interval iteration"
  },
  "storm-sound-best": {
    "meta": [
      "storm-sound",
      "storm-sound-bisim",
      "storm-hybrid-sound",
      "storm-sound-ddbisim",
      "storm-exact",
      "storm-exact-bisim"
    ],
    "description": "Best of all sound storm configs."
  }
}