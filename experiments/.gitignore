plots/latex/data/

# The Modest Toolset (see docker/modest/README.md), unpacked by build_docker.sh
docker/modest/*.zip
docker/modest/amd64/
docker/modest/arm64/

# The saved image, see build_docker.sh, and the artifact, see ../scripts/5_create_artifact.sh
storm2-experiments.tar.gz
storm2-experiments-artifact.zip
experiments/imdps/benchmarks.tar.xz
experiments/imdps/benchmarks.tar.xz.*

# All results of the paper are part of the repository, including their logs, and
# so are those of the sample runs of ../scripts/2_smoke.sh and ../scripts/3_representative.sh
!paper_results/**/logs/
!paper_results/**/*.log
!artifact-results/**/logs/
!artifact-results/**/*.log
